{
  "name": "sitios-web-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI determinista de la plataforma de automatización de sitios (Base 4/8 de BASES_DEL_SISTEMA.md) — arranca con Fase 0.",
  "type": "module",
  "bin": {
    "cli": "./dist/index.js"
  },
  "scripts": {
