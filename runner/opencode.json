{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "provider": {
    "opencode": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "supabase": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx", "-y", "@supabase/mcp-server-supabase@latest",
        "--project-ref=aoowwztkitctnwbbwbwk"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GH_PAT}"
      }
    },
    "openseo": {
      "type": "remote",
      "enabled": true,
      "url": "https://openseo.lab.whitelabel.lat/mcp",
      "headers": {
        "Authorization": "Bearer {env:OPENSEO_TOKEN}"
      }
    }
  }
}
